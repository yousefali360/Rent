# إعدادات الخادم وقاعدة البيانات
APP_ENV=development
DATABASE_URL=sqlite:///./rent_search.db
TIMEZONE=Africa/Cairo

# مزودات البحث العامة (اختيارية - يعمل النظام بدونها عبر الفهرس العام وروابط فيسبوك المباشرة والاستيراد المصرح به)
# 1. Google Custom Search JSON API (للبحث في الصفحات العامة المفهرسة)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# 2. Serper.dev API (بديل سريع لنتائج بحث جوجل العامة)
SERPER_API_KEY=

# 3. تفعيل المزود العام المجاني (DuckDuckGo HTML / Lite للصفحات المفهرسة علنًا)
ENABLE_PUBLIC_WEB_PROVIDER=true

# إعدادات التحديث الدوري (المرحلة الخامسة)
AUTO_REFRESH_INTERVAL_MINUTES=60
